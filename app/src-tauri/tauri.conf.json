{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quire",
  "version": "0.1.7",
  "identifier": "org.quire.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Quire",
        "width": 1240,
        "height": 880,
        "minWidth": 640,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5NDI1QUU0QjZBQjE3Q0IKUldUTEY2dTI1RnBDcVcrN1FJdEdIcExkL21IUjE3ak92NFVlZC81VlpyV092NDZWRnVEV21sRlQK",
      "endpoints": ["https://github.com/guidofraga/quire/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Free-form engineering math notebook",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "fileAssociations": [
      {
        "ext": ["quire"],
        "name": "Quire Document",
        "description": "Quire worksheet",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": { "identifier": "org.quire.document", "conformsTo": ["com.apple.package", "public.composite-content"] }
      },
      {
        "ext": ["quirez"],
        "name": "Quire Single-File Document",
        "description": "Quire worksheet in one file",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/vnd.quire+zip",
        "exportedType": { "identifier": "org.quire.document.single", "conformsTo": ["public.zip-archive", "public.data"] }
      }
    ]
  }
}
