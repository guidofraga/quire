{
  "format": "quire/1",
  "meta": { "title": "Simply Supported Beam", "authors": ["Your Name"] },
  "settings": { "display": { "decimals": 3, "resultUnits": "working" } },
  "styles": { "numbering": { "headings": "1.1", "tables": "Table {n} –" } },
  "page": {
    "view": "pages",
    "paper": "A4",
    "margins": { "top": "20mm", "right": "20mm", "bottom": "20mm", "left": "20mm" },
    "footer": { "left": "{title}", "right": "{page} / {pages}", "color": "#8a8f98" }
  },
  "regions": [
    { "id": "b00", "kind": "text", "at": [0, 0], "text": "{.title}\n# Simply supported steel beam" },
    { "id": "b01", "kind": "text", "at": [0, 54], "width": 640, "text": "Bending and deflection of a simply supported beam under a uniform load. Change the data and everything below follows." },
    { "id": "b02", "kind": "text", "at": [0, 108], "text": "# Data" },
    { "id": "b03", "kind": "math", "at": [0, 144], "expr": "L:=6 m", "note": "span" },
    { "id": "b04", "kind": "math", "at": [0, 180], "expr": "E:=210 GPa" },
    { "id": "b05", "kind": "math", "at": [180, 180], "expr": "f.y:=355 MPa" },
    { "id": "b06", "kind": "math", "at": [0, 216], "expr": "I:=3892 cm^4", "note": "IPE 240" },
    { "id": "b07", "kind": "math", "at": [180, 216], "expr": "W:=324 cm^3" },
    { "id": "b08", "kind": "table", "at": [0, 270], "name": "loads", "header": { "row": true },
      "caption": { "text": "Loads per metre", "position": "above" },
      "display": { "decimals": 2 },
      "columns": [{ "width": 110 }, { "width": 110 }, { "width": 70 }, { "width": 110 }],
      "rows": [["Load", "Characteristic", "γ", "Design"],
               ["Dead", "4.5 kN/m", "1.35", "=B2*C2"],
               ["Live", "3 kN/m", "1.5", "=B3*C3"],
               ["Total", "=SUM(B2:B3)", "", "=SUM(D2:D3)"]] },
    { "id": "b09", "kind": "math", "at": [0, 414], "expr": "q.k:=loads[4, 2]", "show": "value" },
    { "id": "b10", "kind": "math", "at": [234, 414], "expr": "q.d:=loads[4, 4]", "show": "value" },
    { "id": "b11", "kind": "text", "at": [0, 468], "text": "# Calculations" },
    { "id": "b12", "kind": "math", "at": [0, 504], "expr": "M.d:=q.d*L^2/8", "show": "value", "note": "design moment" },
    { "id": "b12a", "kind": "math", "at": [0, 558], "expr": "M(x):=q.d*x*(L-x)/2" },
    { "id": "b12b", "kind": "plot2d", "at": [0, 603], "size": [440, 240], "series": [{ "y": "M(x)", "x": "x", "range": "0 m..L", "label": "Design moment" }], "axes": { "y": { "label": "M" } }, "grid": true, "extrema": true, "caption": { "text": "Bending moment along the span" } },
    { "id": "b13", "kind": "math", "at": [0, 900], "expr": "σ:=M.d/W", "show": "value", "display": { "unit": "MPa" } },
    { "id": "b14", "kind": "math", "at": [0, 954], "expr": "δ:=5*q.k*L^4/(384*E*I)", "show": "value", "display": { "unit": "mm", "decimals": 1 } },
    { "id": "b15", "kind": "math", "at": [0, 1008], "expr": "δ.lim:=L/250", "show": "value", "display": { "unit": "mm", "decimals": 1 } },
    { "id": "b16", "kind": "text", "at": [0, 1062], "text": "# Checks" },
    { "id": "b17", "kind": "table", "at": [0, 1098], "name": "checks", "header": { "row": true },
      "caption": { "text": "Summary of checks", "position": "above" },
      "display": { "decimals": 2 },
      "columns": [{ "width": 110 }, { "width": 100 }, { "width": 100 }, { "width": 70 }, { "width": 80, "align": "center" }],
      "rows": [["Check", "Value", "Limit", "Ratio", "Result"],
               ["Bending", "=σ", "=f.y", "=B2/C2", "=IF(D2<=1, \"OK\", \"FAIL\")"],
               ["Deflection", "=δ", "=δ.lim", "=B3/C3", "=IF(D3<=1, \"OK\", \"FAIL\")"]] }
  ]
}
