  "regions": [
    {"id": "crmnxn", "kind": "text", "text": "{.title}\n# Steel hanger in tension", "at": [0, 0]},
    {"id": "crbpwv", "kind": "text", "text": "Worked example in the report format · EN 1993-1-1", "at": [0, 34]},
    {
