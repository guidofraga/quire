  "regions": [
    { "id": "g00", "kind": "text", "at": [0, 0], "text": "{.title}\n# Programs" },
    { "id": "g01", "kind": "text", "at": [0, 54], "width": 640, "text": "Conditions, loops and blocks of statements, drawn on rows of their own as in Mathcad and SMath. A chain of conditions reads if … else if … else; a single condition with plain values stays on one line." },
    { "id": "g02", "kind": "text", "at": [0, 117], "text": "# Conditions" },
    { "id": "g03", "kind": "math", "at": [0, 153], "expr": "grade(x) := if(x ≥ 90, \"A\", if(x ≥ 80, \"B\", \"C\"))" },
    { "id": "g04", "kind": "math", "at": [306, 153], "expr": "grade(85)", "show": "value" },
    { "id": "g05", "kind": "math", "at": [306, 198], "expr": "grade(95)", "show": "value" },
    { "id": "g06", "kind": "math", "at": [0, 288], "expr": "class(t) := if(t < 5 mm, \"thin\", if(t < 20 mm, \"plate\", if(t < 80 mm, \"thick\")))" },
    { "id": "g07", "kind": "math", "at": [306, 288], "expr": "class(12 mm)", "show": "value" },
    { "id": "g08", "kind": "math", "at": [0, 414], "expr": "s(x) := if(x > 0, 1, -1)" },
    { "id": "g09", "kind": "math", "at": [306, 414], "expr": "s(-3) + if(2 > 1, 10, 20)", "show": "value" },
    { "id": "g10", "kind": "math", "at": [0, 459], "expr": "h(x) := if(x ≤ 1, block(a := 2*x, a^2), if(x ≤ 2, x + 1, block(b := x/2, if(b > 3, b, 3))))" },
    { "id": "g11", "kind": "math", "at": [306, 459], "expr": "h(0.5) + h(1.5) + h(10)", "show": "value" },
    { "id": "g12", "kind": "text", "at": [0, 621], "text": "# Loops" },
    { "id": "g13", "kind": "math", "at": [0, 657], "expr": "total(n) := block(s := 0, for(i, 1..n, s := s + i), s)" },
    { "id": "g14", "kind": "math", "at": [306, 657], "expr": "total(10)", "show": "value" },
    { "id": "g15", "kind": "math", "at": [0, 765], "expr": "fact(n) := block(p := 1, k := 1, while(k ≤ n, block(p := p*k, k := k + 1)), p)" },
    { "id": "g16", "kind": "math", "at": [306, 765], "expr": "fact(5)", "show": "value" },
    { "id": "g17", "kind": "math", "at": [0, 900], "expr": "odd(n) := block(c := 0, for(i := 1, i ≤ n, i := i + 2, c := c + 1), c)" },
    { "id": "g18", "kind": "math", "at": [306, 900], "expr": "odd(9)", "show": "value" },
    { "id": "g19", "kind": "math", "at": [0, 1008], "expr": "steps(n) := block(c := 0, while(n > 1, block(n := if(mod(n, 2) == 0, n/2, 3*n + 1), c := c + 1)), c)" },
    { "id": "g20", "kind": "math", "at": [306, 1008], "expr": "steps(6)", "show": "value" }
  ]
